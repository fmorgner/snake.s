{
    "cmake.options.statusBarVisibility": "visible",
    "cmake.copyCompileCommands": "${workspaceFolder}/build/compile_commands.json",
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.S": "${capture}.tests.c, ${capture}.h",
    },
    "cSpell.words": [
        "cmocka",
        "ifndef",
        "Lexit",
        "offsetof",
        "stdc",
        "stddef"
    ]
}